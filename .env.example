# Copy this file to .env and fill in your key
GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000

# How many PDF pages to send to the LLM per extraction call.
# Lower = more calls but safer for very dense pages. Higher = fewer calls.
PAGES_PER_CHUNK=6
